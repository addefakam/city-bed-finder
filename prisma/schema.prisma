generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Read-only models — mirrors the main GHMS schema.
// The guest app only reads Provider, Room, and Settings.
// GuestReport is created via raw SQL (see src/lib/prisma.ts).

enum ProviderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  SUITE
  DELUXE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

model Provider {
  id          String         @id @default(cuid())
  name        String
  ownerName   String
  phone       String
  email       String         @default("")
  address     String         @default("")
  type        String         @default("GUEST_HOUSE")
  licenseNo   String         @default("")
  status      ProviderStatus @default(PENDING)
  latitude    Float          @default(9.02)
  longitude   Float          @default(38.75)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  rooms    Room[]
  settings Settings?

  @@index([status])
}

model Room {
  id            String     @id @default(cuid())
  number        String
  name          String
  type          RoomType
  pricePerNight Float
  floor         Int
  capacity      Int
  status        RoomStatus @default(AVAILABLE)
  amenities     String
  description   String
  providerId    String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  provider Provider @relation(fields: [providerId], references: [id])

  @@unique([number, providerId])
  @@index([providerId])
  @@index([status])
}

model Settings {
  id              String   @id @default(cuid())
  guestHouseName  String   @default("Guest House")
  address         String   @default("")
  phone           String   @default("")
  email           String   @default("")
  currency        String   @default("ETB")
  checkInTime     String   @default("14:00")
  checkOutTime    String   @default("12:00")
  providerId      String?  @unique
  provider        Provider? @relation(fields: [providerId], references: [id])

  @@index([providerId])
}
